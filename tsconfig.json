{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"],
    "rootDir": ".",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@setu-ts/common": ["./.tmp/declarations/common/src/index.d.ts"],
      "@setu-ts/diagnostics-plugin": [
        "./.tmp/declarations/diagnostics-plugin/src/index.d.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
